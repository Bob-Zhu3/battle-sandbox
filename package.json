{
  "name": "battle-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "play": "vite --host 0.0.0.0 --open /",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && node scripts/build-pages.mjs",
    "build:site": "npm run build && node scripts/build-hosted.mjs",
    "start": "node server/start.ts",
    "demo:spells": "vite --host 127.0.0.1 --open /?demo=spells",
    "demo:sound": "vite --host 127.0.0.1 --open /?demo=sound",
    "demo:pixels": "vite --host 127.0.0.1 --open /?demo=pixels",
    "predemo:encounters": "npm run build --silent",
    "demo:encounters": "node scripts/demo-encounters.mjs",
    "predemo:motion": "npm run build --silent",
    "demo:motion": "node scripts/demo-encounters.mjs --motion",
    "predemo:siege": "npm run build --silent",
    "demo:siege": "node scripts/demo-encounters.mjs --siege",
    "predemo:room": "npm run build --silent",
    "demo:room": "node scripts/demo-room.mjs",
    "predemo:oddities": "npm run build --silent",
    "demo:oddities": "node scripts/demo-encounters.mjs --oddities",
    "precheck:modes": "npm run build --silent",
    "check:modes": "node scripts/check-modes.mjs",
    "precheck:invites": "npm run build --silent",
    "check:invites": "node scripts/check-invites.mjs",
    "predemo:retry": "npm run build --silent",
    "demo:retry": "node scripts/demo-room.mjs --retry",
    "predemo:reconnect": "npm run build --silent",
    "demo:reconnect": "node scripts/demo-room.mjs --reconnect",
    "predemo:crash": "npm run build:site --silent",
    "demo:crash": "node scripts/demo-crash.mjs",
    "bench:crowd": "node scripts/bench-crowd.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "sirv": "3.0.2",
    "ws": "8.23.0"
  }
}
