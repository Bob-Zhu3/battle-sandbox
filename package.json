{
  "name": "battle-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "demo:characters": "vite --host 127.0.0.1 --open /?demo=shoulder",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node server/start.ts",
    "demo:room": "node scripts/demo-room.mjs",
    "predemo:retry": "npm run build --silent",
    "demo:retry": "node scripts/demo-room.mjs --retry",
    "predemo:reconnect": "npm run build --silent",
    "demo:reconnect": "node scripts/demo-room.mjs --reconnect",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "sirv": "3.0.2",
    "ws": "8.23.0"
  }
}
